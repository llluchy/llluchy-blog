---
import { withBase } from '../utils/path';

interface NavPost {
	id: string;
	title: string;
}

interface Props {
	prev?: NavPost | null;
	next?: NavPost | null;
	prevLabel?: string;
	nextLabel?: string;
}

const {
	prev,
	next,
	prevLabel = '上一篇',
	nextLabel = '下一篇',
} = Astro.props;
---

{(prev || next) && (
	<nav class="post-nav" aria-label="文章导航">
		{prev ? (
			<a class="post-nav-link prev" href={withBase('blog', prev.id, '/')}>
				<span class="post-nav-dir">← {prevLabel}</span>
				<span class="post-nav-title">{prev.title}</span>
			</a>
		) : (
			<span class="post-nav-link placeholder"></span>
		)}
		{next ? (
			<a class="post-nav-link next" href={withBase('blog', next.id, '/')}>
				<span class="post-nav-dir">{nextLabel} →</span>
				<span class="post-nav-title">{next.title}</span>
			</a>
		) : (
			<span class="post-nav-link placeholder"></span>
		)}
	</nav>
)}

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin: 1.25rem 0;
	}
	.post-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.9rem 1rem;
		border: 1px solid rgb(var(--border-light));
		border-radius: var(--radius-md);
		background: rgb(var(--bg-elevated));
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
		min-height: 4.2rem;
	}
	.post-nav-link:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow-card);
	}
	.post-nav-link.next {
		text-align: right;
		align-items: flex-end;
	}
	.post-nav-link.placeholder {
		visibility: hidden;
		pointer-events: none;
	}
	.post-nav-dir {
		font-size: 0.75rem;
		color: rgb(var(--text-light));
		font-weight: 600;
	}
	.post-nav-title {
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.35;
		color: rgb(var(--text));
	}
	@media (max-width: 640px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.post-nav-link.next {
			text-align: left;
			align-items: flex-start;
		}
		.post-nav-link.placeholder {
			display: none;
		}
	}
</style>
