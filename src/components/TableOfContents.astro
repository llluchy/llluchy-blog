---
export interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	title?: string;
}

const { headings, title = '目录' } = Astro.props;
const items = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
	<aside class="toc" aria-label={title}>
		<p class="toc-title">{title}</p>
		<nav class="toc-nav">
			<ul>
				{items.map((h) => (
					<li class={`toc-item depth-${h.depth}`}>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ul>
		</nav>
	</aside>
)}

<style>
	.toc {
		position: sticky;
		top: 5.5rem;
		max-height: calc(100vh - 6.5rem);
		overflow: auto;
		padding: 1rem 0.85rem;
		border: 1px solid rgb(var(--border-light));
		border-radius: var(--radius-md);
		background: rgb(var(--bg-elevated));
		align-self: start;
	}
	.toc-title {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--text-light));
	}
	.toc-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-item {
		margin: 0 0 0.35rem;
	}
	.toc-item a {
		display: block;
		padding: 0.25rem 0.4rem;
		border-radius: 6px;
		font-size: 0.82rem;
		line-height: 1.4;
		color: rgb(var(--text-muted));
		text-decoration: none;
		border-left: 2px solid transparent;
	}
	.toc-item a:hover,
	.toc-item a.active {
		color: var(--accent);
		background: rgba(var(--accent-rgb), 0.08);
		border-left-color: var(--accent);
	}
	.toc-item.depth-3 a {
		padding-left: 0.9rem;
		font-size: 0.78rem;
	}
	@media (max-width: 1100px) {
		.toc {
			display: none;
		}
	}
</style>

<script>
	const links = Array.from(document.querySelectorAll('.toc-item a')) as HTMLAnchorElement[];
	if (links.length) {
		const map = new Map<string, HTMLAnchorElement>();
		for (const a of links) {
			const id = decodeURIComponent(a.hash.replace(/^#/, ''));
			if (id) map.set(id, a);
		}
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const id = entry.target.id;
					const active = map.get(id);
					if (!active) continue;
					links.forEach((l) => l.classList.remove('active'));
					active.classList.add('active');
				}
			},
			{ rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] },
		);
		for (const id of map.keys()) {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		}
	}
</script>
