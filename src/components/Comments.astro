---
import { UTTERANCES_CONFIG } from '../consts';
---

<div class="comments">
	<h2>Comments</h2>
	<script
		src="https://utteranc.es/client.js"
		repo={UTTERANCES_CONFIG.repo}
		issue-term={UTTERANCES_CONFIG.issueTerm}
		theme={UTTERANCES_CONFIG.theme}
		crossorigin="anonymous"
		async
	></script>
</div>

<style>
	.comments {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.comments h2 {
		margin-bottom: 1em;
	}
</style>
