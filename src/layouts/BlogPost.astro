---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostNav from '../components/PostNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { withBase } from '../utils/path';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Heading = { depth: number; slug: string; text: string };
type NavPost = { id: string; title: string };

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: NavPost | null;
	next?: NavPost | null;
	headings?: Heading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	prev = null,
	next = null,
	headings = [],
} = Astro.props;

const hasToc = (headings || []).some((h) => h.depth === 2 || h.depth === 3);
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<meta property="og:type" content="article" />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: title,
			description: description,
			datePublished: pubDate.toISOString(),
			...(updatedDate && { dateModified: updatedDate.toISOString() }),
			author: {
				'@type': 'Person',
				name: 'llluchy',
			},
		})} />
	</head>
	<body>
		<Header />
		<main class:list={['post-main', { 'has-toc': hasToc }]}>
			<a href={withBase('/blog')} class="back-link">← {t('blog.backToList')}</a>
			<div class="post-layout">
				<div class="post-primary">
					<PostNav prev={prev} next={next} />
					<article class="post-article">
						{heroImage && (
							<div class="post-hero">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)}
						<header class="post-header">
							<div class="post-meta">
								<span class="post-date">
									{t('blog.publishedOn')} <FormattedDate date={pubDate} />
								</span>
								{
									updatedDate && (
										<span class="post-updated">
											{t('blog.updatedOn')} <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							{tags.length > 0 && (
								<div class="post-tags">
									{tags.map((tag) => (
										<a class="post-tag" href={`${withBase('/blog')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
									))}
								</div>
							)}
							<h1 class="post-title">{title}</h1>
							<p class="post-desc">{description}</p>
						</header>
						<div class="post-content">
							<slot />
						</div>
						<Comments />
					</article>
					<PostNav prev={prev} next={next} />
				</div>
				{hasToc && <TableOfContents headings={headings} title={lang === 'zh' ? '目录' : 'On this page'} />}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-main {
		max-width: 760px;
		padding: 2rem 1.5rem 4rem;
		margin: 0 auto;
	}
	.post-main.has-toc {
		max-width: 1120px;
	}
	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	.post-main.has-toc .post-layout {
		grid-template-columns: minmax(0, 1fr) 240px;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: rgb(var(--text-muted));
		font-weight: 500;
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.post-article {
		background: rgb(var(--bg-elevated));
		border-radius: var(--radius-xl);
		padding: 2.5rem;
		box-shadow: var(--shadow-card);
		border: 1px solid rgb(var(--border-light));
	}
	.post-hero {
		margin: -2.5rem -2.5rem 2rem -2.5rem;
		overflow: hidden;
		border-radius: var(--radius-xl) var(--radius-xl) 0 0;
	}
	.post-hero :global(img) {
		width: 100%;
		display: block;
	}
	.post-header {
		margin-bottom: 2rem;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.85rem;
		color: rgb(var(--text-light));
		margin-bottom: 0.75rem;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.9rem;
	}
	.post-tag {
		display: inline-block;
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-full);
		font-size: 0.72rem;
		font-weight: 600;
		background: rgba(var(--accent-rgb), 0.1);
		color: var(--accent);
		text-decoration: none;
	}
	.post-tag:hover {
		background: rgba(var(--accent-rgb), 0.18);
	}
	.post-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
		margin-bottom: 0.75rem;
	}
	.post-desc {
		font-size: 1.05rem;
		color: rgb(var(--text-muted));
		margin: 0;
	}
	.post-content {
		line-height: 1.85;
	}
	.post-content :global(h2) {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--border-light));
		scroll-margin-top: 5rem;
	}
	.post-content :global(h3) {
		margin-top: 1.5rem;
		scroll-margin-top: 5rem;
	}
	.post-content :global(p) {
		margin-bottom: 1.25rem;
	}
	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}
	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}
	.post-content :global(img) {
		border-radius: var(--radius-md);
		margin: 1.5rem 0;
	}
	@media (max-width: 1100px) {
		.post-main.has-toc {
			max-width: 760px;
		}
		.post-main.has-toc .post-layout {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 640px) {
		.post-main {
			padding: 1rem 1rem 3rem;
		}
		.post-article {
			padding: 1.5rem;
		}
		.post-hero {
			margin: -1.5rem -1.5rem 1.5rem -1.5rem;
		}
	}
</style>
