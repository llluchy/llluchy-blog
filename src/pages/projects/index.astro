---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = allProjects.map((p) => p.data);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('nav.projects')} | ${SITE_TITLE}`} description={t('projects.subtitle')} />
	</head>
	<body>
		<Header />

		<main class="projects-main">
			<section class="section">
				<h1 class="section-title gradient-text">{t('projects.title')}</h1>
				<p class="section-subtitle">{t('projects.subtitle')}</p>

				{projects.length === 0 ? (
					<p class="no-projects">{lang === 'en' ? 'No projects yet.' : '暂无作品。'}</p>
				) : (
					<div class="projects-grid">
						{projects.map((project) => (
							<a href={project.github} target="_blank" rel="noopener noreferrer" class="project-card">
								<div class="project-card-header">
									<span class="project-icon">{project.icon}</span>
									<div class="project-tags">
										{project.tags.slice(0, 3).map((tag) => (
											<span class="project-tag">{tag}</span>
										))}
									</div>
								</div>
								<h3>{project.title}</h3>
								<p>{project.description[lang]}</p>
								<div class="project-card-footer">
									<span class="github-link">
										<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
											<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
										</svg>
										{t('projects.viewOnGithub')}
									</span>
									<span class="arrow-icon">→</span>
								</div>
							</a>
						))}
					</div>
				)}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.projects-main {
		padding-bottom: 4rem;
	}
	.no-projects {
		text-align: center;
		color: rgb(var(--text-muted));
		font-size: 1.1rem;
		padding: 3rem 0;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 1.5rem;
	}
	.project-card {
		display: flex;
		flex-direction: column;
		background: rgb(var(--bg-elevated));
		border-radius: var(--radius-xl);
		padding: 2rem;
		transition: all 0.3s ease;
		border: 1px solid rgb(var(--border-light));
		color: inherit;
		text-decoration: none;
	}
	.project-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-xl);
		border-color: rgba(var(--accent-rgb), 0.2);
	}
	.project-card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1rem;
	}
	.project-icon {
		font-size: 2.5rem;
	}
	.project-tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	.project-tag {
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-full);
		font-size: 0.7rem;
		font-weight: 500;
		background: rgba(var(--accent-rgb), 0.1);
		color: var(--accent);
	}
	.project-card h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}
	.project-card p {
		font-size: 0.9rem;
		color: rgb(var(--text-muted));
		line-height: 1.6;
		margin-bottom: 1.5rem;
		flex: 1;
	}
	.project-card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--border-light));
	}
	.github-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
	}
	.arrow-icon {
		font-size: 1.2rem;
		color: var(--accent);
		transition: transform 0.3s ease;
	}
	.project-card:hover .arrow-icon {
		transform: translateX(4px);
	}
</style>