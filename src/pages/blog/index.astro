---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { withBase } from '../../utils/path';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(allPosts.map(p => p.data.category || 'general'))];
const tags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))].sort((a, b) => a.localeCompare(b));
const activeTag = Astro.url.searchParams.get('tag') || '';
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('nav.blog')} | ${SITE_TITLE}`} description="Blog articles" />
	</head>
	<body>
		<Header />
		<main class="blog-list-main">
			<section class="section">
				<h1 class="section-title gradient-text">{t('nav.blog')}</h1>
				<p class="section-subtitle">{t('section.blog.subtitle')}</p>

				{allPosts.length === 0 ? (
					<p class="no-posts">{t('blog.noPosts')}</p>
				) : (
					<>
						<div class="category-filters" role="tablist" aria-label="Categories">
							<button class="cat-btn active" data-filter-type="category" data-category="all">{t('blog.allCategories')}</button>
							{categories.map(cat => (
								<button class="cat-btn" data-filter-type="category" data-category={cat}>{t(`blog.category.${cat}`)}</button>
							))}
						</div>
						{tags.length > 0 && (
							<div class="tag-filters" role="tablist" aria-label="Tags">
								<button class={`tag-btn ${activeTag ? '' : 'active'}`} data-filter-type="tag" data-tag="all">全部标签</button>
								{tags.map((tag) => (
									<button class={`tag-btn ${activeTag === tag ? 'active' : ''}`} data-filter-type="tag" data-tag={tag}>{tag}</button>
								))}
							</div>
						)}
						<div class="blog-grid">
							{allPosts.map((post) => (
								<a
									href={withBase('blog', post.id, '/')}
									class="blog-card"
									data-category={post.data.category || 'general'}
									data-tags={(post.data.tags || []).join('|')}
								>
									{post.data.heroImage && (
										<div class="blog-card-image">
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										</div>
									)}
									<div class="blog-card-content">
										<span class="blog-category">{t(`blog.category.${post.data.category || 'general'}`)}</span>
										{(post.data.tags || []).length > 0 && (
											<div class="blog-tags">
												{(post.data.tags || []).map((tag) => (
													<span class="blog-tag">{tag}</span>
												))}
											</div>
										)}
										<div class="blog-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<span class="read-more">{t('blog.readMore')} →</span>
									</div>
								</a>
							))}
						</div>
					</>
				)}
			</section>
		</main>
		<Footer />
		<script>
			const cards = Array.from(document.querySelectorAll('.blog-card'));
			let activeCategory = 'all';
			let activeTag = new URLSearchParams(window.location.search).get('tag') || 'all';

			function applyFilters() {
				cards.forEach((card) => {
					const catOk = activeCategory === 'all' || card.dataset.category === activeCategory;
					const tags = (card.dataset.tags || '').split('|').filter(Boolean);
					const tagOk = activeTag === 'all' || tags.includes(activeTag);
					card.style.display = catOk && tagOk ? '' : 'none';
				});
			}

			document.querySelectorAll('.cat-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					document.querySelectorAll('.cat-btn').forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					activeCategory = btn.dataset.category || 'all';
					applyFilters();
				});
			});

			document.querySelectorAll('.tag-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					document.querySelectorAll('.tag-btn').forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					activeTag = btn.dataset.tag || 'all';
					const url = new URL(window.location.href);
					if (activeTag === 'all') url.searchParams.delete('tag');
					else url.searchParams.set('tag', activeTag);
					window.history.replaceState({}, '', url);
					applyFilters();
				});
			});

			applyFilters();
		</script>
	</body>
</html>

<style>
	.blog-list-main {
		padding-bottom: 4rem;
	}
	.no-posts {
		text-align: center;
		color: rgb(var(--text-muted));
		font-size: 1.1rem;
		padding: 3rem 0;
	}
	.category-filters {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	.cat-btn {
		padding: 0.5rem 1.2rem;
		border: 1px solid rgb(var(--border-light));
		border-radius: var(--radius-full);
		background: transparent;
		color: rgb(var(--text-muted));
		font-size: 0.85rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.cat-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.cat-btn.active {
		background: var(--accent);
		color: #fff;
		border-color: var(--accent);
	}
	.blog-category {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-full);
		font-size: 0.7rem;
		font-weight: 500;
		background: rgba(var(--accent-rgb), 0.1);
		color: var(--accent);
		margin-bottom: 0.5rem;
		width: fit-content;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.5rem;
	}
	.blog-card {
		display: flex;
		flex-direction: column;
		background: rgb(var(--bg-elevated));
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: all 0.3s ease;
		border: 1px solid rgb(var(--border-light));
		color: inherit;
		text-decoration: none;
	}
	.blog-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-xl);
	}
	.blog-card-image {
		aspect-ratio: 16/9;
		overflow: hidden;
	}
	.blog-card-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.blog-card:hover .blog-card-image :global(img) {
		transform: scale(1.03);
	}
	.blog-card-content {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.blog-date {
		font-size: 0.8rem;
		color: rgb(var(--text-light));
		margin-bottom: 0.75rem;
	}
	.blog-card-content h3 {
		margin-bottom: 0.5rem;
		font-size: 1.15rem;
		line-height: 1.4;
	}
	.blog-card-content p {
		font-size: 0.9rem;
		margin-bottom: 1rem;
		flex: 1;
	}
	.read-more {
		color: var(--accent);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.tag-filters {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin: -1rem 0 2rem;
	}
	.tag-btn {
		padding: 0.35rem 0.9rem;
		border: 1px dashed rgb(var(--border-light));
		border-radius: var(--radius-full);
		background: transparent;
		color: rgb(var(--text-muted));
		font-size: 0.8rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.tag-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.tag-btn.active {
		background: rgba(var(--accent-rgb), 0.12);
		color: var(--accent);
		border-style: solid;
		border-color: var(--accent);
	}
	.blog-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.55rem;
	}
	.blog-tag {
		display: inline-block;
		padding: 0.12rem 0.5rem;
		border-radius: var(--radius-full);
		font-size: 0.68rem;
		font-weight: 600;
		background: rgba(var(--accent-rgb), 0.08);
		color: var(--accent);
	}
</style>