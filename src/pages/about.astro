---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const aboutContent = {
	en: {
		intro: "Hi! I'm a passionate full-stack developer who loves building things that live on the internet. I enjoy turning complex problems into simple, beautiful solutions.",
		details: [
			"When I'm not coding, you'll find me exploring new technologies, contributing to open-source projects, or writing technical articles on my blog.",
			"I believe in continuous learning and sharing knowledge with the community. Every problem is an opportunity to learn something new.",
			"Beyond technology, I'm a coffee enthusiast, a casual gamer, and always up for a good conversation about innovation and ideas.",
		],
	},
	zh: {
		intro: '你好！我是一名热爱全栈开发的工程师，喜欢构建有价值的互联网产品。我享受将复杂问题转化为简洁、优雅的解决方案的过程。',
		details: [
			'不写代码的时候，我会探索新技术、参与开源项目，或者在博客上写一些技术文章。',
			'我坚信持续学习和与社区分享知识的重要性。每一个问题都是学习新东西的机会。',
			'除了技术，我还是一个咖啡爱好者、休闲游戏玩家，随时愿意聊聊创新和有趣的点子。',
		],
	},
};

const timeline = {
	en: [
		{ year: '2024', title: 'Senior Full-Stack Developer', desc: 'Leading architecture and development of large-scale web applications.' },
		{ year: '2022', title: 'Full-Stack Developer', desc: 'Built and shipped multiple production applications serving millions of users.' },
		{ year: '2020', title: 'Frontend Engineer', desc: 'Focused on React ecosystem, performance optimization, and design systems.' },
		{ year: '2019', title: 'Started Coding Journey', desc: 'Wrote my first lines of code and fell in love with building things.' },
	],
	zh: [
		{ year: '2024', title: '高级全栈工程师', desc: '主导大型 Web 应用的架构设计与开发。' },
		{ year: '2022', title: '全栈开发工程师', desc: '构建并交付了多个服务数百万用户的生产级应用。' },
		{ year: '2020', title: '前端工程师', desc: '专注于 React 生态、性能优化和设计系统建设。' },
		{ year: '2019', title: '开启编程之旅', desc: '写下了第一行代码，从此爱上了构建东西的感觉。' },
	],
};

const hobbies = {
	en: [
		{ icon: '📚', name: 'Reading', desc: 'Tech blogs, sci-fi, and self-improvement books' },
		{ icon: '🎮', name: 'Gaming', desc: 'Indie games and strategy games' },
		{ icon: '☕', name: 'Coffee', desc: 'Exploring specialty coffee brewing methods' },
		{ icon: '🎵', name: 'Music', desc: 'Lo-fi, electronic, and acoustic vibes' },
	],
	zh: [
		{ icon: '📚', name: '阅读', desc: '技术博客、科幻小说和自我提升类书籍' },
		{ icon: '🎮', name: '游戏', desc: '独立游戏和策略类游戏' },
		{ icon: '☕', name: '咖啡', desc: '探索精品咖啡的各种冲煮方式' },
		{ icon: '🎵', name: '音乐', desc: 'Lo-fi、电子和原声音乐' },
	],
};

const skills = {
	en: [
		{ name: 'Frontend Development', level: 95 },
		{ name: 'Backend Development', level: 85 },
		{ name: 'UI/UX Design', level: 75 },
		{ name: 'DevOps & Cloud', level: 70 },
	],
	zh: [
		{ name: '前端开发', level: 95 },
		{ name: '后端开发', level: 85 },
		{ name: 'UI/UX 设计', level: 75 },
		{ name: 'DevOps & 云服务', level: 70 },
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('nav.about')} | ${SITE_TITLE}`} description={aboutContent[lang].intro} />
	</head>
	<body>
		<Header />

		<section class="about-hero">
			<div class="about-hero-bg"></div>
			<div class="about-hero-content">
				<div class="avatar-lg">
					<span class="avatar-emoji">👨‍💻</span>
				</div>
				<h1 class="gradient-text">{t('section.about')}</h1>
				<p class="about-intro">{aboutContent[lang].intro}</p>
			</div>
		</section>

		<section class="section">
			<div class="about-details">
				{aboutContent[lang].details.map((p) => <p>{p}</p>)}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('section.skills')}</h2>
			<p class="section-subtitle">{t('section.skills.subtitle')}</p>
			<div class="skills-bars">
				{skills[lang].map((s) => (
					<div class="skill-bar">
						<div class="skill-bar-header">
							<span class="skill-bar-name">{s.name}</span>
							<span class="skill-bar-level">{s.level}%</span>
						</div>
						<div class="skill-bar-track">
							<div class="skill-bar-fill" style={`--level: ${s.level}%`}></div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('section.timeline')}</h2>
			<p class="section-subtitle">{t('section.timeline.subtitle')}</p>
			<div class="timeline">
				{timeline[lang].map((item) => (
					<div class="timeline-item">
						<div class="timeline-dot"></div>
						<div class="timeline-content">
							<span class="timeline-year">{item.year}</span>
							<h3>{item.title}</h3>
							<p>{item.desc}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">
				{lang === 'en' ? 'Hobbies & Interests' : '爱好 & 兴趣'}
			</h2>
			<p class="section-subtitle">
				{lang === 'en' ? 'Things I enjoy beyond coding' : '编程之外我喜欢做的事'}
			</p>
			<div class="hobbies-grid">
				{hobbies[lang].map((h) => (
					<div class="hobby-card">
						<div class="hobby-icon">{h.icon}</div>
						<h3>{h.name}</h3>
						<p>{h.desc}</p>
					</div>
				))}
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.about-hero {
		position: relative;
		padding: 5rem 0 3rem;
		overflow: hidden;
		text-align: center;
	}
	.about-hero-bg {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at center, rgba(99, 102, 241, 0.1) 0%, transparent 60%);
		z-index: 0;
	}
	.about-hero-content {
		position: relative;
		z-index: 1;
	}
	.avatar-lg {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: var(--gradient-primary);
		padding: 4px;
		margin: 0 auto 1.5rem;
		box-shadow: 0 10px 40px rgba(99, 102, 241, 0.3);
	}
	.avatar-lg .avatar-emoji {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: rgb(var(--bg-elevated));
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3.5rem;
	}
	.about-intro {
		max-width: 600px;
		margin: 0 auto;
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.about-details {
		max-width: 800px;
		margin: 0 auto;
	}
	.about-details p {
		font-size: 1rem;
		line-height: 1.9;
		margin-bottom: 1.25rem;
	}

	.skills-bars {
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.skill-bar-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.skill-bar-name {
		font-weight: 600;
		color: rgb(var(--text));
	}
	.skill-bar-level {
		font-weight: 600;
		color: var(--accent);
	}
	.skill-bar-track {
		height: 8px;
		background: rgb(var(--border-light));
		border-radius: var(--radius-full);
		overflow: hidden;
	}
	.skill-bar-fill {
		height: 100%;
		width: var(--level);
		background: var(--gradient-primary);
		border-radius: var(--radius-full);
		transition: width 1s ease-out;
	}

	.timeline {
		max-width: 700px;
		margin: 0 auto;
		position: relative;
		padding-left: 2rem;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 7px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: rgb(var(--border));
	}
	.timeline-item {
		position: relative;
		padding-bottom: 2rem;
	}
	.timeline-dot {
		position: absolute;
		left: -1.75rem;
		top: 0.25rem;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--gradient-primary);
		box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
	}
	.timeline-year {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		background: rgba(var(--accent-rgb), 0.1);
		padding: 0.2rem 0.75rem;
		border-radius: var(--radius-full);
		margin-bottom: 0.5rem;
	}
	.timeline-content h3 {
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}
	.timeline-content p {
		margin: 0;
		font-size: 0.95rem;
	}

	.hobbies-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
	}
	.hobby-card {
		background: rgb(var(--bg-elevated));
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		text-align: center;
		transition: all 0.3s ease;
		border: 1px solid rgb(var(--border-light));
	}
	.hobby-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}
	.hobby-icon {
		font-size: 2.5rem;
		margin-bottom: 0.75rem;
	}
	.hobby-card h3 {
		margin-bottom: 0.5rem;
		font-size: 1.05rem;
	}
	.hobby-card p {
		margin: 0;
		font-size: 0.85rem;
	}
</style>
