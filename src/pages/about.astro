---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const aboutData = (await getCollection('about'))[0]?.data;
const skillsData = (await getCollection('skills'))[0]?.data;
const timelineEntries = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
const hobbyEntries = (await getCollection('hobbies')).sort((a, b) => a.data.order - b.data.order);

const aboutContent = aboutData ? { intro: aboutData.intro, details: aboutData.details, contactEmail: aboutData.contactEmail } : { intro: { en: '', zh: '' }, details: { en: [], zh: [] }, contactEmail: '' };
const timeline = timelineEntries.map(e => e.data);
const hobbies = hobbyEntries.map(e => e.data);
const aboutSkills = skillsData?.aboutSkills || [];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('nav.about')} | ${SITE_TITLE}`} description={aboutContent.intro[lang]} />
	</head>
	<body>
		<Header />

		<section class="about-hero">
			<div class="about-hero-bg"></div>
			<div class="about-hero-content">
				<div class="avatar-lg">
					<span class="avatar-emoji">👨‍💻</span>
				</div>
				<h1 class="gradient-text">{t('section.about')}</h1>
				<p class="about-intro">{aboutContent.intro[lang]}</p>
			</div>
		</section>

		<section class="section">
			<div class="about-details">
				{aboutContent.details[lang].map((p) => <p>{p}</p>)}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('section.skills')}</h2>
			<p class="section-subtitle">{t('section.skills.subtitle')}</p>
			<div class="skills-bars">
				{aboutSkills.map((s) => (
					<div class="skill-bar">
						<div class="skill-bar-header">
							<span class="skill-bar-name">{s.name[lang]}</span>
							<span class="skill-bar-level">{s.level}%</span>
						</div>
						<div class="skill-bar-track">
							<div class="skill-bar-fill" style={`--level: ${s.level}%`}></div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('section.timeline')}</h2>
			<p class="section-subtitle">{t('section.timeline.subtitle')}</p>
			<div class="timeline">
				{timeline.map((item) => (
					<div class="timeline-item">
						<div class="timeline-dot"></div>
						<div class="timeline-content">
							<span class="timeline-year">{item.year}</span>
							<h3>{item.title[lang]}</h3>
							<p>{item.description[lang]}</p>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('about.hobbies')}</h2>
			<p class="section-subtitle">{t('about.hobbies.subtitle')}</p>
			<div class="hobbies-grid">
				{hobbies.map((h) => (
					<div class="hobby-card">
						<div class="hobby-icon">{h.icon}</div>
						<h3>{h.name[lang]}</h3>
						<p>{h.description[lang]}</p>
					</div>
				))}
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">{t('about.contact')}</h2>
			<p class="section-subtitle">{t('about.contact.subtitle')}</p>
			<div class="contact-card">
				<div class="contact-item">
					<span class="contact-icon">📧</span>
					<div>
						<div class="contact-label">{t('about.email')}</div>
						<a href={`mailto:${aboutContent.contactEmail}`} class="contact-value">{aboutContent.contactEmail}</a>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.about-hero {
		position: relative;
		padding: 5rem 0 3rem;
		overflow: hidden;
		text-align: center;
	}
	.about-hero-bg {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at center, rgba(99, 102, 241, 0.1) 0%, transparent 60%);
		z-index: 0;
	}
	.about-hero-content {
		position: relative;
		z-index: 1;
	}
	.avatar-lg {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: var(--gradient-primary);
		padding: 4px;
		margin: 0 auto 1.5rem;
		box-shadow: 0 10px 40px rgba(99, 102, 241, 0.3);
	}
	.avatar-lg .avatar-emoji {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: rgb(var(--bg-elevated));
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3.5rem;
	}
	.about-intro {
		max-width: 600px;
		margin: 0 auto;
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.about-details {
		max-width: 800px;
		margin: 0 auto;
	}
	.about-details p {
		font-size: 1rem;
		line-height: 1.9;
		margin-bottom: 1.25rem;
	}

	.skills-bars {
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.skill-bar-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.skill-bar-name {
		font-weight: 600;
		color: rgb(var(--text));
	}
	.skill-bar-level {
		font-weight: 600;
		color: var(--accent);
	}
	.skill-bar-track {
		height: 8px;
		background: rgb(var(--border-light));
		border-radius: var(--radius-full);
		overflow: hidden;
	}
	.skill-bar-fill {
		height: 100%;
		width: var(--level);
		background: var(--gradient-primary);
		border-radius: var(--radius-full);
		transition: width 1s ease-out;
	}

	.timeline {
		max-width: 700px;
		margin: 0 auto;
		position: relative;
		padding-left: 2rem;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 7px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: rgb(var(--border));
	}
	.timeline-item {
		position: relative;
		padding-bottom: 2rem;
	}
	.timeline-dot {
		position: absolute;
		left: -1.75rem;
		top: 0.25rem;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--gradient-primary);
		box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
	}
	.timeline-year {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		background: rgba(var(--accent-rgb), 0.1);
		padding: 0.2rem 0.75rem;
		border-radius: var(--radius-full);
		margin-bottom: 0.5rem;
	}
	.timeline-content h3 {
		margin-bottom: 0.25rem;
		font-size: 1.1rem;
	}
	.timeline-content p {
		margin: 0;
		font-size: 0.95rem;
	}

	.hobbies-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
	}
	.hobby-card {
		background: rgb(var(--bg-elevated));
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		text-align: center;
		transition: all 0.3s ease;
		border: 1px solid rgb(var(--border-light));
	}
	.hobby-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}
	.hobby-icon {
		font-size: 2.5rem;
		margin-bottom: 0.75rem;
	}
	.hobby-card h3 {
		margin-bottom: 0.5rem;
		font-size: 1.05rem;
	}
	.hobby-card p {
		margin: 0;
		font-size: 0.85rem;
	}

	.contact-card {
		max-width: 500px;
		margin: 0 auto;
		background: rgb(var(--bg-elevated));
		border: 1px solid rgb(var(--border-light));
		border-radius: var(--radius-xl);
		padding: 2rem;
		box-shadow: var(--shadow-card);
	}
	.contact-item {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.contact-icon {
		font-size: 2.5rem;
	}
	.contact-label {
		font-size: 0.85rem;
		color: rgb(var(--text-muted));
		margin-bottom: 0.25rem;
	}
	.contact-value {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--accent);
	}
	.contact-value:hover {
		text-decoration: underline;
	}
</style>